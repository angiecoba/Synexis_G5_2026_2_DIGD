# Datos: no van en Git (ver data/README.md)
data/raw/*
data/processed/*
# data/app/ SÍ se versiona: es la carpeta liviana (~3 MB) que usa la app desplegada
!data/raw/.gitkeep
!data/processed/.gitkeep
# Artefactos del modelo: se publican en Hugging Face Hub
models/*
!models/.gitkeep
# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
# Notebooks: sin checkpoints
.ipynb_checkpoints/
# Secretos
.env
# Sistema
.DS_Store
~$*.xlsx

# Parches que se aplican con git apply: no se guardan en el repositorio
*.patch

# Documentos internos del equipo (viven en el Drive, no en el repositorio público)
docs/equipo/
